# Copiá este archivo a .env y ajustá los valores que necesites.
# Los valores mostrados acá son los defaults de la aplicación.
# Solo sobreescribí lo que quieras cambiar.

# ── Servidor ──────────────────────────────────────────────────────────────────
SERVER_PORT=8080
ENVIRONMENT=local

# ── Credenciales de la API ────────────────────────────────────────────────────
API_USERNAME=admin
API_PASSWORD=changeme

# ── Credenciales del scraper de métricas (Prometheus) ────────────────────────
MONITORING_USERNAME=prometheus
MONITORING_PASSWORD=prom-secret

# ── URLs de las dependencias externas ─────────────────────────────────────────
PROMETHEUS_URL=https://prometheus.mock.meli/api/v1
ARGOCD_URL=https://argocd.mock.meli/api/v1
ALERTMANAGER_URL=https://alertmanager.mock.meli/api/v2

# ── Paginación ────────────────────────────────────────────────────────────────
API_PAGE_DEFAULT_SIZE=20

# ── Logging ───────────────────────────────────────────────────────────────────
# Valores válidos: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL=DEBUG

# ── JVM ───────────────────────────────────────────────────────────────────────
# Sobreescribir JVM_OPTS solo si necesitás ajustar GC u heap para tu entorno.
# Ejemplo para máquinas con poca RAM (512 MB):
#   JVM_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=60.0 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom
#JVM_OPTS=
